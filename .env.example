# Copy to .env. Every value is also settable as an environment variable.

# Required. Must match the Keycloak client scope exactly: tokens are accepted only for
# audience node:<CIRCULESS_NODE_NODE_ID>.
CIRCULESS_NODE_NODE_ID=alpha-onprem

CIRCULESS_NODE_ISSUER=http://127.0.0.1:8080/realms/circuless
CIRCULESS_NODE_CLOUD_API_URL=https://api.circuless.eu

CIRCULESS_NODE_DATABASE_URL=sqlite:///./data/node.db
CIRCULESS_NODE_DATA_DIR=./data

# Gateway- and overlay-facing.
CIRCULESS_NODE_PUBLIC_HOST=0.0.0.0
CIRCULESS_NODE_PUBLIC_PORT=8000

# /healthz, /metrics, /internal/authz and the API docs. Loopback, or the overlay address —
# never the gateway-facing interface (R8).
CIRCULESS_NODE_INTERNAL_HOST=127.0.0.1
CIRCULESS_NODE_INTERNAL_PORT=8001

# Exact origins, JSON array. Never "*" — the node refuses to start with a wildcard (G7).
CIRCULESS_NODE_CORS_ALLOW_ORIGINS=["https://ui.circuless.eu"]
