# Environment for deploy/docker-compose.yml. Copy to deploy/.env.
#
# The node's own settings take the CIRCULESS_NODE_ prefix; these are the few the compose
# file needs to build the container environment, plus the NetBird peer name.
CIRCULESS_NODE_ID=alpha-onprem
CIRCULESS_NODE_ISSUER=https://auth.circuless.bavenir.eu/realms/circuless
CIRCULESS_NODE_CLOUD_API_URL=https://api.circuless.bavenir.eu
# A JSON list. Exact origins only; the node refuses to start on `*` (G7).
CIRCULESS_NODE_CORS_ALLOW_ORIGINS=["https://ui.circuless.bavenir.eu"]
# bvr | partner. A BVR-operated node refuses classification=sensitive (D22).
CIRCULESS_NODE_OPERATOR=partner
