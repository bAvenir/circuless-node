#!/usr/bin/env bash
# Branch name, then staged secrets. H1 wants gitleaks in pre-commit as well as in CI:
# CI catches a secret after it is in the history, where the remedy is rotation rather
# than a revert. Here it is still just an edit.
set -uo pipefail

if ! command -v bvr-ci >/dev/null 2>&1; then
  echo "bvr-ci not found — install it (uv tool install ...) to work in this repo" >&2
  exit 1
fi

branch=$(git symbolic-ref --short -q HEAD) || exit 0
bvr-ci check-branch "$branch" || exit 1

# `protect --staged` scans what is about to be committed, not the whole history — which
# keeps the hook fast enough that nobody reaches for --no-verify.
if command -v gitleaks >/dev/null 2>&1; then
  gitleaks protect --staged --no-banner --redact || {
    echo "gitleaks found a secret in the staged changes. Remove it before committing." >&2
    exit 1
  }
elif command -v docker >/dev/null 2>&1 && docker info >/dev/null 2>&1; then
  git diff --cached > /tmp/circuless-staged.patch
  docker run --rm -i zricethezav/gitleaks:latest \
      detect --pipe --no-banner --redact < /tmp/circuless-staged.patch || {
    rm -f /tmp/circuless-staged.patch
    echo "gitleaks found a secret in the staged changes. Remove it before committing." >&2
    exit 1
  }
  rm -f /tmp/circuless-staged.patch
else
  # Not silently skipped: a gate that quietly does nothing is worse than no gate,
  # because people stop thinking about it. CI still scans the full history.
  echo "WARNING: neither gitleaks nor Docker is available — staged changes were NOT" >&2
  echo "         scanned for secrets. CI will still scan the full history." >&2
fi

# --- the committed OpenAPI document ---------------------------------------------------
#
# `openapi.json` is generated from the code and committed, and a CI test fails when the
# two disagree. The document embeds the package version, so **every release breaks that
# test**: `bvr-ci patch` bumps `pyproject.toml` and commits, and nothing regenerates the
# schema. It happened at v0.5.4, v0.6.0 and v0.6.1, twice leaving the node's whole suite
# red — the drift check runs before the tests, so it hides whatever else is wrong.
#
# Regenerated here rather than merely reported: the fix is mechanical and has no decision
# in it, and a hook that only complains is one people learn to pass with --no-verify. The
# file joins the commit that caused it to change, which is where it belongs.
if git diff --cached --name-only | grep -qE '^(src/circuless_node/|pyproject\.toml$)'; then
  if command -v uv >/dev/null 2>&1; then
    before=$(git hash-object openapi.json 2>/dev/null || echo none)
    if uv run --quiet circuless-node-openapi >/dev/null 2>&1; then
      after=$(git hash-object openapi.json)
      if [ "$before" != "$after" ]; then
        git add openapi.json
        echo "openapi.json was out of date; regenerated and added to this commit." >&2
      fi
    else
      echo "WARNING: could not regenerate openapi.json. If this commit changes the API" >&2
      echo "         or the version, CI will fail on the drift check." >&2
    fi
  else
    echo "WARNING: uv not found — openapi.json was NOT checked against the code." >&2
  fi
fi
